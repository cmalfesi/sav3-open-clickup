# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
/lib/generated/prisma

# local dev artifacts
/app-*.png
/clickup-*.png
.playwright-mcp/
.claude/

# playwright
/test-results/
/playwright-report/
/blob-report/
.playwright/

# user uploads
/public/uploads/*
!/public/uploads/.gitkeep

# Private user data
/public/restored-files/
/IMPORT_REPORT.json
/clickup_backup*/
/*Backup*.zip
/.local-backups/

/lib/restore-plan.json
/lib/restored-documents.json

/lib/generated/

# Build output and checkout-local state
/dist/
/.vinext/
/.wrangler/
/.sites-runtime/
.dev.vars*
/.npmrc
/work/
/outputs/

# Python import tooling
__pycache__/
*.pyc
